{
  "clientId": "peritial-test-expired",
  "enabled": true,
  "publicClient": true,
  "standardFlowEnabled": false,
  "directAccessGrantsEnabled": true,
  "protocol": "openid-connect",
  "attributes": {
    "access.token.lifespan": "5"
  },
  "defaultClientScopes": [
    "basic",
    "profile",
    "peritial.read"
  ],
  "protocolMappers": [
    {
      "name": "tenant-id",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-hardcoded-claim-mapper",
      "config": {
        "claim.name": "tenant_id",
        "claim.value": "11111111-1111-1111-1111-111111111111",
        "jsonType.label": "String",
        "access.token.claim": "true"
      }
    },
    {
      "name": "audience",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-audience-mapper",
      "config": {
        "included.client.audience": "peritial-api",
        "access.token.claim": "true"
      }
    }
  ]
}
