{
  "realm":"peritial","enabled":true,"registrationAllowed":false,
  "clientScopes":[
    {"name":"peritial.read","protocol":"openid-connect","attributes":{"include.in.token.scope":"true"}},
    {"name":"peritial.write","protocol":"openid-connect","attributes":{"include.in.token.scope":"true"}}
  ],
  "clients":[
    {"clientId":"peritial-web","enabled":true,"publicClient":true,"standardFlowEnabled":true,"directAccessGrantsEnabled":false,
      "redirectUris":["http://localhost:5173/*","http://127.0.0.1:4173/*"],
      "webOrigins":["http://localhost:5173","http://127.0.0.1:4173"],
      "defaultClientScopes":["web-origins","acr","roles","profile","email","peritial.read","peritial.write"],
      "protocolMappers":[
        {"name":"tenant-id","protocol":"openid-connect","protocolMapper":"oidc-hardcoded-claim-mapper",
          "config":{"claim.name":"tenant_id","claim.value":"11111111-1111-1111-1111-111111111111","jsonType.label":"String","access.token.claim":"true"}},
        {"name":"peritial-audience","protocol":"openid-connect","protocolMapper":"oidc-audience-mapper",
          "config":{"included.client.audience":"peritial-api","access.token.claim":"true"}}
      ]},
    {"clientId":"peritial-api","enabled":true,"bearerOnly":true}
  ],
  "users":[{"username":"localuser","enabled":true,
    "credentials":[{"type":"password","value":"local-only-user","temporary":false}]}]
}