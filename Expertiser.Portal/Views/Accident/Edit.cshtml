@model TableAccident

@{
    ViewData["Title"] = "Create";
}

<h1>@SharedLocalizer["Accident"]</h1>
<div>
    <a asp-action="Index">@SharedLocalizer["Back to List"]</a>
</div>
@if (Model != null)
{
    <div class="form-group mt-3">
        <label>@SharedLocalizer["Manage Expertises"]</label>
        @foreach (var expertise in Model.TableExpertise)
        {
            if (Manager.UserHelperManager.IsManager || expertise.ContributorId == Manager.UserHelperManager.Id)
            {
                <a asp-action="Edit" asp-controller="Experty" asp-route-id="@expertise.Id" class="page-link bg-secondary text-white">
                    @expertise.Id - @expertise.Member?.UserName - @expertise.Contributor?.UserName - @expertise.AssignmentDate - @expertise.InspectionDate
                </a>
            }
        }
    </div>
}
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="AddressId" class="control-label"></label>
                @if (Manager.UserHelperManager.IsManager)
                {
                    <partial name="_GetDropdownLocations" model="Model?.AddressId ?? 0" />
                }
                else
                {
                    <input type="hidden" asp-for="AddressId" />
                    <div class="form-control">@Model?.Address?.Address @Model?.Address?.City?.Name @Model?.Address?.City?.PostalCode</div>
                }
                <span asp-validation-for="AddressId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="InsuranceId" class="control-label"></label>
                @if (Manager.UserHelperManager.IsManager)
                {
                    <div id="insurances">
                        <partial name="_GetInsurances" model="Model?.InsuranceId ?? 0" />
                    </div>
                    <rystem-ajax-modal rystem-request-context="Manager.AjaxRequestManager.CreateNewInsurance" rystem-size="Large">
                        <div class="btn btn-primary mt-2">@SharedLocalizer["Create New Insurance"]</div>
                    </rystem-ajax-modal>
                }
                else
                {
                    <input type="hidden" asp-for="InsuranceId" />
                    <div class="form-control">@Model?.Insurance?.Customer?.Name @Model?.Insurance?.InsuranceCompany?.Label</div>
                }
                <span asp-validation-for="InsuranceId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="InsuranceAgencyId" class="control-label"></label>
                @if (Manager.UserHelperManager.IsManager)
                {
                    <div id="insurance-agencies">
                        <partial name="_GetInsuranceAgencies" model="Model?.InsuranceAgencyId" />
                    </div>
                    <rystem-ajax-modal rystem-request-context="Manager.AjaxRequestManager.CreateNewInsuranceAgency" rystem-size="Large">
                        <div class="btn btn-primary mt-2">@SharedLocalizer["Create New Insurance Agency"]</div>
                    </rystem-ajax-modal>
                }
                else
                {
                    <input type="hidden" asp-for="InsuranceAgencyId" />
                    <div class="form-control">@Model?.InsuranceAgency?.Label</div>
                }
                <span asp-validation-for="InsuranceAgencyId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="InsuranceAdjusterId" class="control-label"></label>
                @if (Manager.UserHelperManager.IsManager)
                {
                    <div id="insurance-adjusters">
                        <partial name="_GetInsuranceAdjusters" model="Model?.InsuranceAdjusterId" />
                    </div>
                    <rystem-ajax-modal rystem-request-context="Manager.AjaxRequestManager.CreateNewInsuranceAdjuster" rystem-size="Large">
                        <div class="btn btn-primary mt-2">@SharedLocalizer["Create New Insurance Adjuster"]</div>
                    </rystem-ajax-modal>
                }
                else
                {
                    <input type="hidden" asp-for="InsuranceAgencyId" />
                    <div class="form-control">@Model?.InsuranceAdjuster?.Name</div>
                }
                <span asp-validation-for="InsuranceAgencyId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="InspectorateId" class="control-label"></label>
                @if (Manager.UserHelperManager.IsManager)
                {
                    <div id="inspectorates">
                        <partial name="_GetInspectorates" model="Model?.InspectorateId" />
                    </div>
                    <rystem-ajax-modal rystem-request-context="Manager.AjaxRequestManager.CreateNewInspectorate" rystem-size="Large">
                        <div class="btn btn-primary mt-2">@SharedLocalizer["Create New Inspectorate"]</div>
                    </rystem-ajax-modal>
                }
                else
                {
                    <input type="hidden" asp-for="InspectorateId" />
                    <div class="form-control">@Model?.Inspectorate?.Label</div>
                }
            </div>
            <div class="form-group">
                <label asp-for="TableDamaged" class="control-label"></label>
                @if (Manager.UserHelperManager.IsManager)
                {
                    <rystem-dropdown name="Damageds" rystem-data="Manager.DropdownManager.GetDamagedCustomers(Model?.TableDamaged.Select(x => x.CustomerId))" rystem-data-multiple="true"></rystem-dropdown>
                    <rystem-ajax-modal rystem-request-context="Manager.AjaxRequestManager.CreateNewDamaged" rystem-size="Large">
                        <div class="btn btn-primary mt-2">@SharedLocalizer["Create New Damaged"]</div>
                    </rystem-ajax-modal>
                }
                else
                {
                    <input type="hidden" asp-for="TableDamaged" />
                    <div class="form-control">@Model?.Inspectorate?.Label</div>
                }
            </div>
            <div class="form-group">
                <label asp-for="ExternalId" class="control-label"></label>
                @if (Manager.UserHelperManager.IsManager)
                {
                    <input asp-for="ExternalId" class="form-control" />
                }
                else
                {
                    <input type="hidden" asp-for="ExternalId" />
                    <div class="form-control">@Model?.ExternalId</div>
                }
                <span asp-validation-for="ExternalId" class="text-danger"></span>
            </div>
            <div class="form-row">
                <div class="form-group col-md-6">
                    <label asp-for="AccidentDate" class="control-label"></label>
                    @if (Manager.UserHelperManager.IsManager)
                    {
                        <rystem-date name="AccidentDate" value="Model?.AccidentDate" class="form-control"></rystem-date>
                    }
                    else
                    {
                        <input type="hidden" asp-for="AccidentDate" />
                        <div class="form-control">@Model?.AccidentDate</div>
                    }
                    <span asp-validation-for="AccidentDate" class="text-danger"></span>
                </div>
                <div class="form-group col-md-6">
                    <label asp-for="DenunciationDate" class="control-label"></label>
                    @if (Manager.UserHelperManager.IsManager)
                    {
                        <rystem-date name="DenunciationDate" value="Model?.DenunciationDate" class="form-control"></rystem-date>
                    }
                    else
                    {
                        <input type="hidden" asp-for="DenunciationDate" />
                        <div class="form-control">@Model?.DenunciationDate</div>
                    }
                    <span asp-validation-for="DenunciationDate" class="text-danger"></span>
                </div>
            </div>
            @if (Manager.UserHelperManager.IsManager)
            {
                <div class="form-group">
                    <input type="submit" value="@SharedLocalizer["Save"]" class="btn btn-primary" />
                </div>
            }
        </form>
    </div>
</div>