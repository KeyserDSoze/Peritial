@model TableAccident

@{
    ViewData["Title"] = "Create";
}

<h1>@SharedLocalizer["Create"]</h1>

<h4>@SharedLocalizer["Accident"]</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="AddressId" class="control-label"></label>
                <partial name="_GetDropdownLocations" model="Model?.AddressId ?? 0" />
                <span asp-validation-for="AddressId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="InsuranceId" class="control-label"></label>
                <div id="insurances">
                    <partial name="_GetInsurances" model="Model?.InsuranceId ?? 0" />
                </div>
                <rystem-ajax-modal rystem-request-context="Manager.ModalManager.CreateNewInsurance" rystem-size="Large">
                    <div class="btn btn-primary mt-2">@Localizer["Create New Insurance"]</div>
                </rystem-ajax-modal>
                <span asp-validation-for="InsuranceId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="InsuranceAgencyId" class="control-label"></label>
                <rystem-dropdown name="InsuranceAgencyId" rystem-data="Manager.DropdownManager.GetInsuranceAgencies()" class="form-control"></rystem-dropdown>
                <span asp-validation-for="InsuranceAgencyId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="InspectorateId" class="control-label"></label>
                <rystem-dropdown name="InspectorateId" rystem-data="Manager.DropdownManager.GetInspectorates()"></rystem-dropdown>
            </div>
            <div class="form-group">
                <label asp-for="ExternalId" class="control-label"></label>
                <input asp-for="ExternalId" class="form-control" />
                <span asp-validation-for="ExternalId" class="text-danger"></span>
            </div>
            <div class="form-row">
                <div class="form-group col-md-6">
                    <label asp-for="AccidentDate" class="control-label"></label>
                    <rystem-date name="AccidentDate" value="Model.AccidentDate" class="form-control"></rystem-date>
                    <span asp-validation-for="AccidentDate" class="text-danger"></span>
                </div>
                <div class="form-group col-md-6">
                    <label asp-for="DenunciationDate" class="control-label"></label>
                    <rystem-date name="DenunciationDate" value="Model.DenunciationDate" class="form-control"></rystem-date>
                    <span asp-validation-for="DenunciationDate" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group">
                <label>@SharedLocalizer["Connected Expertises"]</label>
                @foreach (var expertise in Model.TableExpertise)
                {
                    <a asp-action="Edit" asp-controller="Experty" asp-route-id="@expertise.Id" class="page-link">
                        @expertise.Id - @expertise.Member?.UserName - @expertise.Contributor?.UserName - @expertise.AssignmentDate - @expertise.InspectionDate
                    </a>
                }
            </div>
            <div class="form-group">
                <input type="submit" value="@SharedLocalizer["Save"]" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>
<div>
    <a asp-action="Index">@SharedLocalizer["Back to List"]</a>
</div>