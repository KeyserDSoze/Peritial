@model Expertiser.Database.Models.TableAccident

@{
    ViewData["Title"] = "Create";
}

<h1>@SharedLocalizer["Create"]</h1>

<h4>@SharedLocalizer["Accident"]</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="PlaceId" class="control-label"></label>
                <div id="accidentLocation">
                    <partial name="_GetLocations" model="0" />
                </div>
                <rystem-ajax-modal rystem-request-context="Manager.ModalManager.CreateNewLocation" rystem-size="Large">
                    <div>@SharedLocalizer["Create"]</div>
                </rystem-ajax-modal>
            </div>
            <div class="form-group">
                <label asp-for="InsuranceId" class="control-label"></label>
                <select asp-for="InsuranceId" class="form-control" asp-items="ViewBag.InsuranceId"></select>
            </div>
            <div class="form-group">
                <label asp-for="InsuranceAgencyId" class="control-label"></label>
                <select asp-for="InsuranceAgencyId" class="form-control" asp-items="ViewBag.InsuranceAgencyId"></select>
            </div>
            <div class="form-group">
                <label asp-for="InspectorateId" class="control-label"></label>
                <select asp-for="InspectorateId" class="form-control" asp-items="ViewBag.InspectorateId"></select>
            </div>
            <div class="form-group">
                <label asp-for="ExternalId" class="control-label"></label>
                <input asp-for="ExternalId" class="form-control" />
                <span asp-validation-for="ExternalId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AccidentDate" class="control-label"></label>
                <input asp-for="AccidentDate" class="form-control" />
                <span asp-validation-for="AccidentDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DenunciationDate" class="control-label"></label>
                <input asp-for="DenunciationDate" class="form-control" />
                <span asp-validation-for="DenunciationDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

