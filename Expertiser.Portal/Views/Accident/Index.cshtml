@model IEnumerable<Expertiser.Database.Models.TableAccident>

@{
    ViewData["Title"] = "Index";
}

<h1>@SharedLocalizer["Index"]</h1>

<p>
    <a asp-action="Create">@SharedLocalizer["Create New"]</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ExternalId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AccidentDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DenunciationDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Inspectorate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Insurance)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.InsuranceAgency)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Place)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ExternalId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AccidentDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DenunciationDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Inspectorate.Label)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Insurance.ExternalId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.InsuranceAgency.Label)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Place.Id)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
