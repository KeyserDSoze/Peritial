@model IEnumerable<TableMessage>

@foreach (var message in Model)
{
    <a class="page-link" href="#">
        <div class="font-weight-bold">
            <div class="text-dark h5 font-weight-bold">@Html.Raw(message.Value)</div>
            <div class="h5">@message.User.UserName</div>
        </div>
    </a>
}