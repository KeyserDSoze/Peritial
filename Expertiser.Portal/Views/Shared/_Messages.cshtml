@model IEnumerable<TableMessage>

@foreach (var message in Model)
{
    <a class="page-link" href="#">
        <div class="font-weight-bold">
            <div class="text-truncate">@Html.Raw(message.Value)</div>
            <div class="small text-gray-500">@message.User.UserName</div>
        </div>
    </a>
}