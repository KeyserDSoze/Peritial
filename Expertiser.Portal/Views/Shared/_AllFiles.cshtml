@model TableExpertise

@{
    var currentState = await Manager.GetExpertyStateAsync(Model.Id, this.SharedLocalizer);
    bool isFirstTime = true;
}

@foreach (var typeOfFiles in currentState.Files)
{
    @if (isFirstTime)
    {
        isFirstTime = false;
    }
    else
    {
        <hr style="width:100%" />
    }
    <div class="col-md-6">
        <label class="control-label">@SharedLocalizer[typeOfFiles.Name.Trim('/')]</label>
        <partial name="_Files" model='(Model.ConcreteId, typeOfFiles, await Manager.FileManager.GetUriFiles(Model.FileId, typeOfFiles.Name), Model)' />
    </div>
    <div class="col-md-6">
        <rystem-ajax-file rystem-message='' rystem-request-context='new RoutingContext() { Action = "Upload", Controller = "File", QueryString = new Dictionary<object, object>() { { "name", typeOfFiles.Name }, { "status", (int)typeOfFiles.MinimumStatus }, {"force", (int)typeOfFiles.ForceToStatus }, { "fileId", Model.FileId } } }'></rystem-ajax-file>
    </div>
}