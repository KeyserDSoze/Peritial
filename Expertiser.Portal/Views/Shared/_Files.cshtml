@model (string ConcreteId, ExpertiseDocument Document, IList<string> Files, TableExpertise Expertise)

<div class="mb-2 mt-2">
    @if (Model.Files.Count == 0)
    {
        <div class="h2 mb-0 expertise-file"><i class="fas fa-file-alt"></i></div>
    }
    else
    {

        string classOfFiles = $"files_{Guid.NewGuid().ToString("N")}";
        string allUrl = string.Empty;
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">@SharedLocalizer["Show"]</th>
                    <th scope="col">@SharedLocalizer["Type"]</th>
                    <th scope="col">#</th>
                </tr>
            </thead>
            <tbody>
                @foreach (string value in Model.Files)
                {
                    allUrl += $"urls={value}&";
                    <tr>
                        <td>
                            @if (Model.Document.Type == DocumentType.Image)
                            {
                                <rystem-ajax-modal rystem-request-context="Manager.AjaxRequestManager.ShowImage(value)" rystem-size="Large">
                                    <img class="col-md-4 btn" src="@value" />
                                </rystem-ajax-modal>
                            }
                            else
                            {
                                <rystem-ajax-modal rystem-request-context="Manager.AjaxRequestManager.ShowDocument(value)" rystem-size="Large">
                                    <div class="expertise-file"><i title="@value.Split('/').Last()" class="fas @GetRightIcon(value) text-xl-left"></i></div>
                                </rystem-ajax-modal>
                            }
                        </td>
                        <td>
                            @value.Split('.').Last()
                        </td>
                        @*<td>
                                <a href="../../../../../../file/proxy?url=@value" class="h2 @classOfFiles" download>
                                    <div class="expertise-file"><i title="@value.Split('/').Last()" class="fas fa-file-download text-xl-left"></i></div>
                                </a>
                            </td>*@
                        <td>
                            <rystem-ajax-button rystem-request-context="Manager.AjaxRequestManager.DeleteDocument(value, Model.Expertise.Id)">
                                <i class="fas fa-trash text-xl-left"></i>
                            </rystem-ajax-button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div style="cursor:pointer;position:relative;float:left;" onclick="experty.downloadAllFiles('../../../../../../file/proxy?name=@Model.ConcreteId&@allUrl')">@SharedLocalizer["Download All"]</div>

    }
</div>

@{
    string GetRightIcon(string name)
    {
        return name.Split('.').Last().ToLower() switch
        {
            "pdf" => "fa-file-pdf",
            "docx" => "fa-file-word",
            "doc" => "fa-file-word",
            "xlsx" => "fa-file-excel",
            "xls" => "fa-file-excel",
            _ => "fa-file-download"
        };
    }
}
