@model (string Label, IList<string> Files)

<div class="mb-2 mt-2">
    @if (Model.Files.Count == 0)
    {
        <div class="h2 mb-0"><i class="fas fa-file-alt"></i></div>
    }
    else
    {
        @*<rystem-carousel rystem-data="Model" rystem-options="CarouselComponent.Default"></rystem-carousel>*@
        @foreach (string value in Model.Files)
        {
            @if (value.Contains(".jpg") || value.Contains(".png"))
            {
                <a href="@value" target="_blank"><img title="@value.Split('/').Last()" src="@value" class="col-md-4" /></a>
            }
            else
            {
                <a href="@value" target="_blank" class="h2"><i title="@value.Split('/').Last()" class="fas fa-file-download text-xl-left"></i></a>
            }
        }
    }
</div>