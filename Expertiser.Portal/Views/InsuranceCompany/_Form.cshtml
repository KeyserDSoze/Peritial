@model Expertiser.Database.Models.TableInsuranceCompany

@Html.AntiForgeryToken()
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<input type="hidden" asp-for="Id" />
<div class="form-group">
    <label asp-for="Label" class="control-label"></label>
    <input asp-for="Label" class="form-control" />
    <span asp-validation-for="Label" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="AddressId" class="control-label"></label>
    <partial name="_GetDropdownLocations" model="Model?.AddressId" />
    <span asp-validation-for="AddressId" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="Alias" class="control-label"></label>
    <input asp-for="Alias" class="form-control" />
    <span asp-validation-for="Alias" class="text-danger"></span>
</div>
<div class="form-group">
    <label class="control-label">@SharedLocalizer["Insurance Company Id"]</label>
    <input asp-for="ExternalId" class="form-control" />
    <span asp-validation-for="ExternalId" class="text-danger"></span>
</div>
<div class="form-group form-check">
    <label class="form-check-label">
        <input class="form-check-input" asp-for="IsActive" /> @Html.DisplayNameFor(model => model.IsActive)
    </label>
</div>
@if (Model != null && Model.Id > 0)
{
    <div class="form-group">
        <a href="https://@Manager.BlobBaseUri/templates/@(Model.Id).docx" target="_blank" download>@SharedLocalizer["Download"] @SharedLocalizer["Template"]</a>
    </div>
    <div class="form-group">
        <rystem-ajax-file rystem-message='@SharedLocalizer["Drag&Drop or Click to Upload"] @SharedLocalizer["Template"]' rystem-request-context='new RoutingContext() { Action = "ImportTemplate", Controller = "InsuranceCompany" }'></rystem-ajax-file>
    </div>
}
<div class="form-group">
    <input type="submit" value="@SharedLocalizer["Save"]" class="btn btn-primary" />
</div>