@model DateStats

@{
    ViewData["Title"] = "Home Page";
}
<h1>Overview</h1>
<div class="row">
    <div class="col-md-3"></div>
    <div class="col-md-6">
        <rystem-ajax-form rystem-request-context="Manager.AjaxRequestManager.ShowStats">
            @Html.AntiForgeryToken()
            <div class="form-row">
                <div class="form-group col-md-4">
                    <label asp-for="From" class="control-label"></label>
                    <rystem-date name="From" value="Model?.From" class="form-control"></rystem-date>
                    <span asp-validation-for="From" class="text-danger"></span>
                </div>
                <div class="form-group col-md-4">
                    <label asp-for="To" class="control-label"></label>
                    <rystem-date name="To" value="Model?.To" class="form-control"></rystem-date>
                    <span asp-validation-for="To" class="text-danger"></span>
                </div>
                <div class="form-group col-md-3">
                    <label class="control-label">&nbsp;</label>
                    <input type="submit" value="@SharedLocalizer["Check"]" class="btn btn-primary form-control" />
                </div>
            </div>
        </rystem-ajax-form>
    </div>
</div>
<hr />
<div id="stats-update">
    <partial name="_Stats" model="Model" />
</div>
