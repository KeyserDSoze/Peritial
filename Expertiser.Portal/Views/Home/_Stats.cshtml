@model DateStats

<div class="w-100">
    <rystem-chart rystem-data="await Manager.ChartManager.GetExpertisesStatus(SharedLocalizer, Model?.From ?? default, Model?.To ?? default)"></rystem-chart>
</div>
@foreach (var contributor in Manager.QueryManager.AllContributors)
{
    var data = await Manager.ChartManager.GetContributorStatus(SharedLocalizer, contributor.Id, Model?.From ?? default, Model?.To ?? default);
    @if (data.Data.Labels.Any())
    {
        <hr />
        <div class="w-100">
            <rystem-chart rystem-data="@data"></rystem-chart>
        </div>
    }
}