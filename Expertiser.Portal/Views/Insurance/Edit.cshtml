@model TableInsurance

@{
    ViewData["Title"] = "Edit";
}

<h1>@SharedLocalizer["Insurance"]</h1>
<div>
    <a asp-action="Index">@SharedLocalizer["Back to List"]</a>
</div>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label class="control-label">@SharedLocalizer["CustomerId"]</label>
                <div id="customers">
                    <partial name="_GetCustomers" model="Model?.CustomerId" />
                </div>
                <rystem-ajax-modal rystem-request-context="Manager.AjaxRequestManager.CreateNewCustomer" rystem-size="Large">
                    <div class="btn btn-primary mt-2">@SharedLocalizer["Create New Customer"]</div>
                </rystem-ajax-modal>

                <span asp-validation-for="CustomerId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ExternalId" class="control-label"></label>
                <input asp-for="ExternalId" class="form-control" />
                <span asp-validation-for="ExternalId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="InsuranceCompanyId" class="control-label"></label>
                <rystem-dropdown name="InsuranceCompanyId" rystem-data="Manager.DropdownManager.GetInsuranceCompanies(Model?.InsuranceCompanyId)"></rystem-dropdown>
                <span asp-validation-for="InsuranceCompanyId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="@SharedLocalizer["Save"]" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>