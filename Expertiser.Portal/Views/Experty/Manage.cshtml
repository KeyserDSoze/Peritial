@model Expertiser.Database.Models.TableExpertise

@{
    ViewData["Title"] = "Edit";
}

<h1>@SharedLocalizer["Edit"]</h1>

<h4>@SharedLocalizer["Expertise"]</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Manage">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="AccidentId" />
            <div class="form-group">
                <label asp-for="MemberId" class="control-label"></label>
                <rystem-dropdown name="MemberId" rystem-data="Manager.DropdownManager.GetMembers(Model?.MemberId)"></rystem-dropdown>
                <span asp-validation-for="MemberId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ContributorId" class="control-label"></label>
                <rystem-dropdown name="ContributorId" rystem-data="Manager.DropdownManager.GetContributors(Model?.ContributorId)"></rystem-dropdown>
                <span asp-validation-for="ContributorId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Status" class="control-label"></label>
                <rystem-dropdown name="Status" rystem-data="Manager.DropdownManager.GetStatus(Model?.Status ?? 0, SharedLocalizer)"></rystem-dropdown>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BranchId" class="control-label"></label>
                <rystem-dropdown name="BranchId" rystem-data="Manager.DropdownManager.GetBranches(Model?.BranchId ?? 0)"></rystem-dropdown>
                <span asp-validation-for="BranchId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ExternalId" class="control-label"></label>
                <input asp-for="ExternalId" class="form-control" />
                <span asp-validation-for="ExternalId" class="text-danger"></span>
            </div>
            <div class="form-row">
                <div class="form-group col-md-6">
                    <label asp-for="AssignmentDate" class="control-label"></label>
                    <rystem-date name="AssignmentDate" value="Model.AssignmentDate" class="form-control"></rystem-date>
                    <span asp-validation-for="AssignmentDate" class="text-danger"></span>
                </div>
                <div class="form-group col-md-6">
                    <label asp-for="InspectionDate" class="control-label"></label>
                    <rystem-date name="InspectionDate" value="Model.InspectionDate" class="form-control"></rystem-date>
                    <span asp-validation-for="InspectionDate" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="Liquidated" class="control-label"></label>
                <input type="number" step="any" name="Liquidated" class="form-control" value="@Model.Liquidated.ToString()" />
                <span asp-validation-for="Liquidated" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="@SharedLocalizer["Save"]" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">@SharedLocalizer["Back to List"]</a>
</div>

