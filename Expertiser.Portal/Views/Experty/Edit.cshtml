@model Expertiser.Database.Models.TableExpertise

@{
    ViewData["Title"] = "Edit";
}

<h1>@SharedLocalizer["Expertise"]</h1>
<div>
    <a asp-action="Index">@SharedLocalizer["Back to List"]</a>
    <hr />
    <a asp-action="Edit" asp-controller="Accident" asp-route-id="@Model?.AccidentId">@SharedLocalizer["Back to Accident"]</a>
</div>
<hr />
<div class="row">
    <div class="col-md-5">
        <form asp-action="Edit">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="AccidentId" />
            <div class="form-group">
                <label asp-for="MemberId" class="control-label"></label>
                @if (Manager.UserHelperManager.IsManager)
                {
                    <rystem-dropdown name="MemberId" rystem-data="Manager.DropdownManager.GetMembers(Model?.MemberId)"></rystem-dropdown>
                }
                else
                {
                    <input type="hidden" asp-for="MemberId" />
                    <div class="form-control">@Model.Member?.UserName</div>
                }
                <span asp-validation-for="MemberId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ContributorId" class="control-label"></label>
                @if (Manager.UserHelperManager.IsManager)
                {
                    <rystem-dropdown name="ContributorId" rystem-data="Manager.DropdownManager.GetContributors(Model?.ContributorId)"></rystem-dropdown>
                }
                else
                {
                    <input type="hidden" asp-for="ContributorId" />
                    <div class="form-control">@Model.Contributor?.UserName</div>
                }
                <span asp-validation-for="ContributorId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Status" class="control-label"></label>
                <rystem-dropdown name="Status" rystem-data="Manager.DropdownManager.GetStatus(Model?.Status ?? 0, SharedLocalizer)"></rystem-dropdown>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BranchId" class="control-label"></label>
                @if (Manager.UserHelperManager.IsManager)
                {
                    <rystem-dropdown name="BranchId" rystem-data="Manager.DropdownManager.GetBranches(Model?.BranchId ?? 0)"></rystem-dropdown>
                }
                else
                {
                    <input type="hidden" asp-for="BranchId" />
                    <div class="form-control">@SharedLocalizer[Model.Branch?.Label]</div>
                }
                <span asp-validation-for="BranchId" class="text-danger"></span>
            </div>
            <div class="form-row">
                <div class="form-group col-md-6">
                    <label asp-for="AssignmentDate" class="control-label"></label>
                    @if (Manager.UserHelperManager.IsManager)
                    {
                        <rystem-date name="AssignmentDate" value="Model.AssignmentDate" class="form-control"></rystem-date>
                    }
                    else
                    {
                        <input type="hidden" asp-for="AssignmentDate" />
                        <div class="form-control">@Model.AssignmentDate</div>
                    }
                    <span asp-validation-for="AssignmentDate" class="text-danger"></span>
                </div>
                <div class="form-group col-md-6">
                    <label asp-for="InspectionDate" class="control-label"></label>
                    <rystem-date name="InspectionDate" value="Model.InspectionDate" class="form-control"></rystem-date>
                    <span asp-validation-for="InspectionDate" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="Liquidated" class="control-label"></label>
                <input type="number" step="any" name="Liquidated" class="form-control" value='@Model.Liquidated?.ToString(CultureInfo.InvariantCulture)' />
                <span asp-validation-for="Liquidated" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="@SharedLocalizer["Save"]" class="btn btn-primary" />
            </div>
        </form>
    </div>
    <div class="col-md-6">
        <div class="row">
            <div class="col-md-6">
                <label class="control-label">@SharedLocalizer["Completed Expertise"]</label>
                <partial name="_Files" model='("Completed Expertise", await Manager.FileManager.GetUriFiles(Model.Id, "expertise"))' />
                <rystem-ajax-file rystem-message='@SharedLocalizer["Drag&Drop or Click to Upload"] @SharedLocalizer["Completed Expertise"]' rystem-request-context='new RoutingContext() { Action = "Upload", Controller = "File", QueryString = new Dictionary<object, object>() { { "name", "expertise" } } }'></rystem-ajax-file>
            </div>
            <div class="col-md-6">
                <label class="control-label">@SharedLocalizer["Reserved Note"]</label>
                <partial name="_Files" model='("Reserved Note", await Manager.FileManager.GetUriFiles(Model.Id, "reservednote"))' />
                <rystem-ajax-file rystem-message='@SharedLocalizer["Drag&Drop or Click to Upload"] @SharedLocalizer["Reserved Note"]' rystem-request-context='new RoutingContext() { Action = "Upload", Controller = "File", QueryString = new Dictionary<object, object>() { { "name", "reservednote" } } }'></rystem-ajax-file>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-md-6">
                <label class="control-label">@SharedLocalizer["Accident Files"]</label>
                <partial name="_Files" model='("Insurance Company Files", await Manager.FileManager.GetUriFiles(Model.Id, "insurancecompany/"))' />
                <rystem-ajax-file rystem-message='@SharedLocalizer["Drag&Drop or Click to Upload"] @SharedLocalizer["Accident Files"]' rystem-request-context='new RoutingContext() { Action = "Upload", Controller = "File", QueryString = new Dictionary<object, object>() { { "name", "insurancecompany/" } }}'></rystem-ajax-file>
            </div>
            <div class="col-md-6">
                <label class="control-label">@SharedLocalizer["Photos"]</label>
                <partial name="_Files" model='("Photos", await Manager.FileManager.GetUriFiles(Model.Id, "photos/"))' />
                <rystem-ajax-file rystem-message='@SharedLocalizer["Drag&Drop or Click to Upload"] @SharedLocalizer["Photos"]' rystem-request-context='new RoutingContext() { Action = "Upload", Controller = "File", QueryString = new Dictionary<object, object>() { { "name", "photos/" } }}'></rystem-ajax-file>
            </div>
        </div>
    </div>
</div>
<hr />
<h1>@SharedLocalizer["Bill"]</h1>
@if (Manager.UserHelperManager.IsManager)
{
    <div class="row mt-3">
        <div id="billwrapper" class="col-md-5">
            <partial name="_EditListBill" model="Model" />
        </div>
    </div>
}
else
{
    <div class="form-control">@Model.TotalPercentage</div>
}
<hr />
<h1>@SharedLocalizer["Messages"]</h1>
<div class="row mt-3">
    <div class="col-md-5">
        <div id="updateMessage">
            <partial name="_Messages" model="Model.TableMessage" />
        </div>
    </div>
    <div class="col-md-6">
        <rystem-ajax-form rystem-request-context='new RequestContext() { Action= "Create", Controller = "Message", RequestType = RequestType.Post, Selector="#updateMessage"}'>
            @Html.AntiForgeryToken()
            <input type="hidden" name="UserId" value="@Manager.UserManager.GetUserId(User)" readonly />
            <input type="hidden" name="ExpertiseId" value="@Model.Id" readonly />
            <rystem-text-area name="Value" rystem-options="SummerNote.DefaultWithHeight(200)"></rystem-text-area>
            <div class="form-group">
                <input type="submit" value="@SharedLocalizer["Insert Message"]" class="btn btn-primary" />
            </div>
        </rystem-ajax-form>
    </div>
</div>