@model Expertiser.Database.Models.TableExpertise

@{
    ViewData["Title"] = "Edit";
}

<h1>@SharedLocalizer["Expertise"] - @Model?.ConcreteId - @Model?.Accident.ExternalId</h1>
<div>
    <a asp-action="Index">@SharedLocalizer["Back to List"]</a>
    <hr />
    <a asp-action="Edit" asp-controller="Accident" asp-route-id="@Model?.AccidentId">@SharedLocalizer["Back to Accident"]</a>
</div>
<hr />
<div class="row">
    <div class="col-md-5">
        <form asp-action="Edit">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="AccidentId" />
            <input type="hidden" asp-for="FileId" />
            @if (Manager.UserHelperManager.IsManager)
            {
                <div class="form-group">
                    <label asp-for="Status" class="control-label"></label>
                    <rystem-dropdown name="Status" rystem-data="Manager.DropdownManager.GetStatus(Model?.Status ?? 0, SharedLocalizer)"></rystem-dropdown>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>
            }
            else
            {
                <input type="hidden" name="Status" value="@Model.Status" />
                <div class="form-group">
                    <label asp-for="Status" class="control-label"></label>
                    <div class="form-control">@SharedLocalizer[Model.StatusType.ToString()]</div>
                </div>
            }
            <div class="form-group">
                <label asp-for="MemberId" class="control-label"></label>
                @if (Manager.UserHelperManager.IsManager)
                {
                    <rystem-dropdown name="MemberId" rystem-data="Manager.DropdownManager.GetMembers(Model?.MemberId)"></rystem-dropdown>
                }
                else
                {
                    <input type="hidden" asp-for="MemberId" />
                    <div class="form-control">@Model.Member?.UserName</div>
                }
                <span asp-validation-for="MemberId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ContributorId" class="control-label"></label>
                @if (Manager.UserHelperManager.IsManager)
                {
                    <rystem-dropdown name="ContributorId" rystem-data="Manager.DropdownManager.GetContributors(Model?.ContributorId)"></rystem-dropdown>
                }
                else
                {
                    <input type="hidden" asp-for="ContributorId" />
                    <div class="form-control">@Model.Contributor?.UserName</div>
                }
                <span asp-validation-for="ContributorId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BranchId" class="control-label"></label>
                @if (Manager.UserHelperManager.IsManager)
                {
                    <rystem-dropdown name="BranchId" rystem-data="Manager.DropdownManager.GetBranches(Model?.BranchId ?? 0)"></rystem-dropdown>
                }
                else
                {
                    <input type="hidden" asp-for="BranchId" />
                    <div class="form-control">@SharedLocalizer[Model.Branch?.Label]</div>
                }
                <span asp-validation-for="BranchId" class="text-danger"></span>
            </div>
            <div class="form-row">
                <div class="form-group col-md-6">
                    <label asp-for="AssignmentDate" class="control-label"></label>
                    @if (Manager.UserHelperManager.IsManager)
                    {
                        <rystem-date name="AssignmentDate" value="Model.AssignmentDate" class="form-control" readonly=@(!Manager.UserHelperManager.IsAdmin)></rystem-date>
                    }
                    else
                    {
                        <input type="hidden" asp-for="AssignmentDate" />
                        <div class="form-control">@Model.AssignmentDate</div>
                    }
                    <span asp-validation-for="AssignmentDate" class="text-danger"></span>
                </div>
                <div class="form-group col-md-6">
                    <label asp-for="InspectionDate" class="control-label"></label>
                    <rystem-date name="InspectionDate" value="Model.InspectionDate" class="form-control" readonly=@(!Manager.UserHelperManager.IsAdmin)></rystem-date>
                    <span asp-validation-for="InspectionDate" class="text-danger"></span>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group col-md-6">
                    <label asp-for="Liquidated" class="control-label"></label>
                    <div class="input-group mb-2">
                        <div class="input-group-prepend">
                            <div class="input-group-text">&euro;</div>
                        </div>
                        <input type="number" step="any" name="Liquidated" class="form-control" value='@Model.Liquidated?.ToString(CultureInfo.InvariantCulture)' />
                    </div>
                </div>
                <span asp-validation-for="Liquidated" class="text-danger"></span>
                <div class="form-group col-md-6">
                    @if (Manager.UserHelperManager.IsManager)
                    {
                        <label asp-for="CloseDate" class="control-label"></label>
                        <rystem-date name="CloseDate" value="Model.CloseDate" class="form-control" readonly=@(!Manager.UserHelperManager.IsAdmin)></rystem-date>
                        <span asp-validation-for="CloseDate" class="text-danger"></span>
                    }
                    else
                    {
                        <input type="hidden" name="CloseDate" value="@Model.CloseDate" />
                        <div class="form-group">
                            <label asp-for="CloseDate" class="control-label"></label>
                            <div class="form-control">@Model.CloseDate?.ToString(System.Threading.Thread.CurrentThread.CurrentCulture)</div>
                        </div>
                    }
                </div>
            </div>
            <div class="form-group">
                <input type="submit" value="@SharedLocalizer["Save"]" class="btn btn-primary" />
            </div>
        </form>
        <hr />
        <h1>@SharedLocalizer["Bill"]</h1>
        @if (Manager.UserHelperManager.IsManager)
        {
            <div class="row mt-3">
                <div id="billwrapper" class="col-md-12">
                    <partial name="_EditListBill" model="Model" />
                </div>
            </div>
        }
        else
        {
            <div class="form-control">&euro; @Model.TotalPercentage</div>
        }
    </div>
    <div class="col-md-1"></div>
    <div class="col-md-6">
        <div class="row" id="update-all-files">
            <rystem-file-manager rystem-files="await Manager.FileManager.GetExpertiseFiles(Model?.FileId)"
                                 rystem-request-context='new RequestContext() { Action = "Upload", Controller = "File", QueryString=new Dictionary<object, object>() { { "fileId", Model.FileId} } }'
                                 rystem-delete-request-context='new RequestContext() { Action = "DeleteDocument", Controller = "File"}'
                                 rystem-localizer="SharedLocalizer"
                                 rystem-skip-path="5"
                                 style="width:100%;"></rystem-file-manager>
        </div>
        
        <div class="mt-3">
            <button type="button" class="btn btn-success btn-block" onclick="downloadPhotographicReport('@Model.FileId')">
                <i class="fa fa-download"></i> @SharedLocalizer["Download Photographic Report"] (PDF)
            </button>
        </div>

        <div class="mt-2">
            <button type="button" class="btn btn-primary btn-block" onclick="downloadPhotographicReportWord('@Model.FileId')">
                <i class="fa fa-file-word-o"></i> @SharedLocalizer["Download Photographic Report"] (Word)
            </button>
        </div>

        @if (Model != null)
        {
            <hr />
            <div class="d-flex flex-column">
                @foreach (var file in await Manager.FileManager.GetTemplateFiles(Model.Accident.InsuranceAgency.InsuranceCompany.Id))
                {
                    <a href="@Manager.BaseUri/Experty/DownloadFinalDocument/@Model.Id?name=@file.Name" download target="_blank" class="mb-2">
                        <i class="fa fa-download"></i> @SharedLocalizer["Download"] @file.Name
                    </a>
                    <br />
                }
            </div>
        }
    </div>
</div>
<hr />
<h1>@SharedLocalizer["Messages"]</h1>
<div class="row mt-3">
    <div class="col-md-5">
        <div id="updateMessage">
            <partial name="_Messages" model="Model.TableMessage" />
        </div>
    </div>
    <div class="col-md-6">
        <rystem-ajax-form rystem-request-context='new RequestContext() { Action= "Create", Controller = "Message", RequestType = RequestType.Post, Selector="#updateMessage"}'>
            @Html.AntiForgeryToken()
            <input type="hidden" name="UserId" value="@Manager.UserManager.GetUserId(User)" readonly />
            <input type="hidden" name="ExpertiseId" value="@Model.Id" readonly />
            <rystem-text-area name="Value" rystem-options="SummerNote.DefaultWithHeight(200)"></rystem-text-area>
            <div class="form-group">
                <input type="submit" value="@SharedLocalizer["Insert Message"]" class="btn btn-primary" />
            </div>
        </rystem-ajax-form>
    </div>
</div>

<script>
    // Auto-refresh del file manager intercettando gli eventi di Dropzone
    document.addEventListener('DOMContentLoaded', function() {
        const fileIdInput = document.querySelector('input[asp-for="FileId"]');
        const fileId = fileIdInput ? fileIdInput.value : null;
        
        if (!fileId) return;
        
        let isRefreshing = false;
        let currentFolderId = null; // Salva la cartella attualmente visualizzata
        
        // Funzione per salvare l'ID della cartella visibile
        function saveCurrentFolder() {
            const visibleFolder = document.querySelector('.folder-container-visible');
            if (visibleFolder) {
                // Estrai l'ID della cartella visibile
                currentFolderId = visibleFolder.className.split(' ').find(cls => cls !== 'folder-container-visible' && cls !== 'folder-container');
                console.log('Cartella salvata:', currentFolderId);
            }
        }
        
        // Funzione per ripristinare il folder dopo il refresh
        function restoreFolder() {
            if (currentFolderId && typeof fileManager !== 'undefined') {
                console.log('Ripristinando cartella:', currentFolderId);
                fileManager.openDirectory(currentFolderId);
            }
        }
        
        // Funzione per ricaricare il file manager
        function refreshFileManager() {
            if (isRefreshing) return;
            isRefreshing = true;
            
            // Salva la cartella prima del refresh
            saveCurrentFolder();
            
            console.log('Aggiornando file manager via Dropzone event...');
            
            fetch(`/File/RefreshFileManager?fileId=${fileId}`)
                .then(response => response.text())
                .then(html => {
                    const fileManagerContainer = document.getElementById('update-all-files');
                    if (fileManagerContainer) {
                        fileManagerContainer.innerHTML = html;
                        console.log('File manager aggiornato');
                        
                        // Ripristina la cartella visibile dopo un piccolo delay
                        setTimeout(restoreFolder, 100);
                        
                        isRefreshing = false;
                    }
                })
                .catch(error => {
                    console.error('Errore nell\'aggiornamento:', error);
                    isRefreshing = false;
                });
        }
        
        // Attendi che Dropzone sia inizializzato
        setTimeout(function() {
            // Cerca tutte le istanze di Dropzone sulla pagina
            if (typeof Dropzone !== 'undefined' && Dropzone.instances && Dropzone.instances.length > 0) {
                Dropzone.instances.forEach(function(dz) {
                    // Ascolta l'evento di successo di Dropzone
                    dz.on('success', function(file, response) {
                        console.log('Dropzone success event rilevato');
                        // Attendi un po' per assicurarsi che il file sia salvato
                        setTimeout(refreshFileManager, 1000);
                    });
                    
                    // Ascolta anche l'evento complete
                    dz.on('complete', function(file) {
                        if (this.getUploadingFiles().length === 0 && this.getQueuedFiles().length === 0) {
                            console.log('Dropzone complete - tutti i file caricati');
                            setTimeout(refreshFileManager, 1000);
                        }
                    });
                    
                    // Ascolta l'evento totaluploadprogress
                    dz.on('totaluploadprogress', function(uploadProgress, totalBytes, totalBytesSent) {
                        if (uploadProgress === 100) {
                            console.log('Upload 100% completato');
                            setTimeout(refreshFileManager, 1000);
                        }
                    });
                });
            }
        }, 2000);
        
        // Fallback: Monitora gli attributi data del componente
        const fileManagerContainer = document.getElementById('update-all-files');
        if (fileManagerContainer) {
            const observer = new MutationObserver(function(mutations) {
                // Se vediamo un elemento con classe "dz-success" aggiunto
                mutations.forEach(function(mutation) {
                    if (mutation.type === 'childList') {
                        const newNodes = mutation.addedNodes;
                        for (let i = 0; i < newNodes.length; i++) {
                            if (newNodes[i].classList && newNodes[i].classList.contains('dz-success')) {
                                console.log('Elemento dz-success rilevato');
                                setTimeout(refreshFileManager, 500);
                                break;
                            }
                        }
                    }
                });
            });
            
            observer.observe(fileManagerContainer, {
                childList: true,
                subtree: true
            });
        }
    });

        // Funzione per scaricare il rapporto fotografico
        function downloadPhotographicReport(fileId) {
            if (!fileId) {
                alert('FileId non trovato');
                return;
            }

            const title = prompt('Inserisci titolo del rapporto (opzionale):', 'Reperti Fotografici');
            let url = `/File/GeneratePhotographicReport?fileId=${fileId}`;

            if (title && title.trim()) {
                url += `&title=${encodeURIComponent(title)}`;
            }

            // Scarica il PDF
            fetch(url)
                .then(response => {
                    if (!response.ok) throw new Error('Error downloading report');

                    // Estrai il nome dal header Content-Disposition
                    const contentDisposition = response.headers.get('content-disposition');
                    let fileName = 'Reperti_Fotografici.pdf';
                    if (contentDisposition) {
                        const fileNameMatch = contentDisposition.match(/filename="?(.+?)"?$/);
                        if (fileNameMatch && fileNameMatch.length > 1) {
                            fileName = fileNameMatch[1];
                        }
                    }

                    return response.blob().then(blob => ({blob, fileName}));
                })
                .then(({blob, fileName}) => {
                    const downloadUrl = window.URL.createObjectURL(blob);
                    const link = document.createElement('a');
                    link.href = downloadUrl;
                    link.download = fileName;
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                    window.URL.revokeObjectURL(downloadUrl);
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Errore nel download del rapporto');
                });
        }

        // Funzione per scaricare il rapporto fotografico in formato Word
        function downloadPhotographicReportWord(fileId) {
            if (!fileId) {
                alert('FileId non trovato');
                return;
            }

            const title = prompt('Inserisci titolo del rapporto (opzionale):', 'Reperti Fotografici');
            let url = `/File/GeneratePhotographicReportWord?fileId=${fileId}`;

            if (title && title.trim()) {
                url += `&title=${encodeURIComponent(title)}`;
            }

            // Scarica il documento Word
            fetch(url)
                .then(response => {
                    if (!response.ok) throw new Error('Error downloading Word report');

                    // Estrai il nome dal header Content-Disposition
                    const contentDisposition = response.headers.get('content-disposition');
                    let fileName = 'Reperti_Fotografici.docx';
                    if (contentDisposition) {
                        const fileNameMatch = contentDisposition.match(/filename="?(.+?)"?$/);
                        if (fileNameMatch && fileNameMatch.length > 1) {
                            fileName = fileNameMatch[1];
                        }
                    }

                    return response.blob().then(blob => ({blob, fileName}));
                })
                .then(({blob, fileName}) => {
                    const downloadUrl = window.URL.createObjectURL(blob);
                    const link = document.createElement('a');
                    link.href = downloadUrl;
                    link.download = fileName;
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);
                    window.URL.revokeObjectURL(downloadUrl);
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Errore nel download del rapporto Word');
                });
        }
</script>