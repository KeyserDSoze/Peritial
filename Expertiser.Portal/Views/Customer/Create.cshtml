@model TableCustomer

<h1>@Localizer["Create Customer"]</h1>
<hr />
<div class="row">
    <div class="col-md-12">
        <rystem-ajax-form rystem-modal-close="true" rystem-request-context="Manager.ModalManager.SetCustomer">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FiscalCode" class="control-label"></label>
                <input asp-for="FiscalCode" class="form-control" />
                <span asp-validation-for="FiscalCode" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AddressId" class="control-label"></label>
                <partial name="_GetDropdownLocations" model="Model?.AddressId ?? 0" />
                <span asp-validation-for="AddressId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </rystem-ajax-form>
    </div>
</div>