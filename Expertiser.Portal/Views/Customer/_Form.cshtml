@model Expertiser.Database.Models.TableCustomer

@Html.AntiForgeryToken()
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<input type="hidden" asp-for="Id" />
<div class="form-group">
    <label asp-for="Name" class="control-label"></label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="FiscalCode" class="control-label"></label>
    <input asp-for="FiscalCode" class="form-control" />
    <span asp-validation-for="FiscalCode" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="AddressId" class="control-label"></label>
    <partial name="_GetDropdownLocations" model="Model?.AddressId" />
    <span asp-validation-for="AddressId" class="text-danger"></span>
</div>
<div class="form-group">
    <input type="submit" value="@SharedLocalizer["Save"]" class="btn btn-primary" />
</div>