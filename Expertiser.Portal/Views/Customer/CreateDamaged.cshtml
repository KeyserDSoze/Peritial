@model TableCustomer

<h3>@SharedLocalizer["Damaged"]</h3>
<div class="row">
    <div class="col-md-12">
        <rystem-ajax-form rystem-modal-close="true" rystem-request-context="Manager.AjaxRequestManager.SetDamaged">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label class="control-label">@SharedLocalizer["Name"]</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label class="control-label">@SharedLocalizer["FiscalCode"]</label>
                <input asp-for="FiscalCode" class="form-control" />
                <span asp-validation-for="FiscalCode" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label class="control-label">@SharedLocalizer["AddressId"]</label>
                <partial name="_GetDropdownLocations" model="Model?.AddressId ?? 0" />
                <span asp-validation-for="AddressId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="@SharedLocalizer["Create"]" class="btn btn-primary" />
            </div>
        </rystem-ajax-form>
    </div>
</div>