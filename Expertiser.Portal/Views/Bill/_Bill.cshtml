@model IEnumerable<UserBillStat>

@if (Manager.UserHelperManager.IsManager)
{
    <h1>Soci</h1>
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Socio</th>
                    <th scope="col">Fatturato totale Gestito</th>
                    <th scope="col">Fatturato esterno</th>
                    <th scope="col">Fatturato netto</th>
                    <th scope="col">Spese</th>
                    <th scope="col">Fatturare</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var userStat in Model.Where(x => x.Member != null))
                {
                    string accordionId = $"accordion-{Guid.NewGuid().ToString("N")}";
                    string accordedId = $"accorded-{accordionId}";
                    <tr class="accordion-toggle collapsed" id="@accordionId" data-toggle="collapse" data-parent="#@accordionId" href="#@accordedId">
                        <td class="expand-button">
                            @if (userStat.Bills.Any())
                            {
                                <i class="fas fa-plus"></i>
                            }
                        </td>
                        <td>@userStat.Member</td>
                        <td>@userStat.TotalBill</td>
                        <td>@userStat.TotalPercentage</td>
                        <td>@userStat.TotalMember</td>
                        <td>&nbsp;</td>
                        <td>&nbsp;</td>
                    </tr>
                    <partial name="_SingleBill" model="(accordedId, userStat.Bills)" />
                }
            </tbody>
        </table>
    </div>
    <hr />
}
<h1>Collaboratori</h1>
<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">Socio</th>
                <th scope="col">Fatturato personale</th>
                <th scope="col">Extra</th>
                <th scope="col">Fatturare</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var userStat in Model.Where(x => x.Contributor != null))
            {
                string accordionId = $"accordion-{Guid.NewGuid().ToString("N")}";
                string accordedId = $"accorded-{accordionId}";
                <tr class="accordion-toggle collapsed" id="@accordionId" data-toggle="collapse" data-parent="#@accordionId" href="#@accordedId">
                    <td class="expand-button">
                        @if (userStat.Bills.Any())
                        {
                            <i class="fas fa-plus"></i>
                        }
                    </td>
                    <td>@userStat.Contributor</td>
                    <td>@(userStat.TotalPercentage - userStat.TotalExtra)</td>
                    <td>@userStat.TotalExtra</td>
                    <td>@userStat.TotalPercentage</td>
                </tr>
                <partial name="_SingleBill" model="(accordedId, userStat.Bills)" />
            }
        </tbody>
    </table>
</div>