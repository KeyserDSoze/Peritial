@model IEnumerable<UserBillStat>

@if (Manager.UserHelperManager.IsManager)
{
    <h1>Soci</h1>
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">@SharedLocalizer["Associate"]</th>
                    <th scope="col">@SharedLocalizer["Total Revenue"]</th>
                    <th scope="col">@SharedLocalizer["Contributor Revenue"]</th>
                    <th scope="col">@SharedLocalizer["Associate Revenue"]</th>
                    <th scope="col">@SharedLocalizer["Net Revenue"]</th>
                    <th scope="col">@SharedLocalizer["Cost"]</th>
                    <th scope="col">@SharedLocalizer["Revenue"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var userStat in Model.Where(x => x.Member != null))
                {
                    string accordionId = $"accordion-{Guid.NewGuid().ToString("N")}";
                    string accordedId = $"accorded-{accordionId}";
                    <tr class="accordion-toggle collapsed" id="@accordionId" data-toggle="collapse" data-parent="#@accordionId" href="#@accordedId">
                        <td class="expand-button">
                            @if (userStat.Bills.Any())
                            {
                                <i class="fas fa-plus"></i>
                            }
                        </td>
                        <td>@userStat.Member</td>
                        <td>@userStat.TotalBill.ToString("N2")</td>
                        <td>@userStat.TotalPercentage.ToString("N2")</td>
                        <td>@userStat.PersonalTotal.ToString("N2")</td>
                        <td>@userStat.TotalMember.ToString("N2")</td>
                        <td>0</td>
                        <td>@((userStat.TotalBill - userStat.TotalPercentage).ToString("N2"))</td>
                    </tr>
                    <partial name="_SingleBill" model="(accordedId, userStat.Bills)" />
                }
            </tbody>
        </table>
    </div>
    <hr />
}
<h1>@SharedLocalizer["Contributors"]</h1>
<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">@SharedLocalizer["Associate"]</th>
                <th scope="col">@SharedLocalizer["Associate Revenue"]</th>
                <th scope="col">@SharedLocalizer["Extra"]</th>
                <th scope="col">@SharedLocalizer["Revenue"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var userStat in Model.Where(x => x.Contributor != null))
            {
                string accordionId = $"accordion-{Guid.NewGuid().ToString("N")}";
                string accordedId = $"accorded-{accordionId}";
                <tr class="accordion-toggle collapsed" id="@accordionId" data-toggle="collapse" data-parent="#@accordionId" href="#@accordedId">
                    <td class="expand-button">
                        @if (userStat.Bills.Any())
                        {
                            <i class="fas fa-plus"></i>
                        }
                    </td>
                    <td>@userStat.Contributor</td>
                    <td>@((userStat.TotalPercentage - userStat.TotalExtra).ToString("N2"))</td>
                    <td>@userStat.TotalExtra.ToString("N2")</td>
                    <td>@userStat.TotalPercentage.ToString("N2")</td>
                </tr>
                <partial name="_SingleBill" model="(accordedId, userStat.Bills)" />
            }
        </tbody>
    </table>
</div>