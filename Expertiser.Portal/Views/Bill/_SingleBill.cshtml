@model (string AccordedId, List<BillStat> Bills)
@{ 
    int counter = 1;
}
@if (Model.Bills.Any())
{
    <tr class="hide-table-padding">
        <td colspan="12">
            <div id="@Model.AccordedId" class="collapse in p-3">
                <table class="table">
                    <thead>
                        <tr>
                            <th scope="col">@SharedLocalizer["Counter"]</th>
                            <th scope="col">@SharedLocalizer["ConcreteId"]</th>
                            <th scope="col">@SharedLocalizer["Contributor"]</th>
                            <th scope="col">@SharedLocalizer["Total"]</th>
                            <th scope="col">@SharedLocalizer["TotalExtra"]</th>
                            <th scope="col">@SharedLocalizer["TotalPercentage"]</th>
                            <th scope="col">@SharedLocalizer["ExternalId"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var singleStat in Model.Bills)
                        {
                            <tr>
                                <td>@counter</td>
                                <td style="cursor:pointer">
                                    <rystem-ajax-modal rystem-request-context="Manager.AjaxRequestManager.EditInModal(singleStat.ExpertiseId)" rystem-size="ExtraLarge">
                                        @singleStat.ConcreteId
                                    </rystem-ajax-modal>
                                </td>
                                <td>@singleStat.Contributor</td>
                                <td>@singleStat.TotalPercentageNoExtra.ToString("N2")</td>
                                <td>@singleStat.TotalExtra.ToString("N2")</td>
                                <td>@singleStat.TotalPercentage.ToString("N2")</td>
                                <td>@singleStat.ExternalId</td>
                            </tr>
                            counter++;
                        }
                    </tbody>
                </table>
            </div>
        </td>
    </tr>
}