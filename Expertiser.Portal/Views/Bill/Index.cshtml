@model (DateStats DateStats, IEnumerable<BillModel> Bills)

@{
    ViewData["Title"] = "Bill";
}

<h1>@SharedLocalizer["Bill"]</h1>
<rystem-ajax-form rystem-request-context="Manager.AjaxRequestManager.ShowRevenue">
    @Html.AntiForgeryToken()
    <div class="form-row">
        <div class="form-group col-md-4">
            <label asp-for="DateStats.From" class="control-label"></label>
            <rystem-date name="From" value="Model.DateStats.From" class="form-control"></rystem-date>
            <span asp-validation-for="DateStats.From" class="text-danger"></span>
        </div>
        <div class="form-group col-md-4">
            <label asp-for="DateStats.To" class="control-label"></label>
            <rystem-date name="To" value="Model.DateStats.To" class="form-control"></rystem-date>
            <span asp-validation-for="DateStats.To" class="text-danger"></span>
        </div>
        <div class="form-group col-md-3">
            <label class="control-label">&nbsp;</label>
            <input type="submit" value="@SharedLocalizer["Check"]" class="btn btn-primary form-control" />
        </div>
    </div>
</rystem-ajax-form>

<div id="revenue-update">
    <partial name="_Bill" model="Model.Bills" />
</div>