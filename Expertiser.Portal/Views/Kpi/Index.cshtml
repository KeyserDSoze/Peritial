@model KpiViewModel

@{
    ViewData["Title"] = "KPI";
}

<h1>@SharedLocalizer["Overview"]</h1>
<hr />

<!-- Filter form: GET so parameters appear in querystring and are reused for export links -->
<form method="get" class="mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-3">
            <label for="from" class="form-label">Data Inizio</label>
            <input type="date" id="from" name="from" class="form-control"
                   value="@(Model.From.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-3">
            <label for="to" class="form-label">Data Fine</label>
            <input type="date" id="to" name="to" class="form-control"
                   value="@(Model.To.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-6">
            <button type="submit" class="btn btn-primary">
                <i class="fa fa-filter"></i> Filtra
            </button>
            <a class="btn btn-outline-secondary ms-2" href="@Url.Action("Index", "Kpi")">
                <i class="fa fa-redo"></i> Reset (Ultimi 3 mesi)
            </a>
        </div>
    </div>
</form>

<div class="alert alert-info">
    <i class="fa fa-info-circle"></i> 
    Stai visualizzando i KPI dal <strong>@Model.From.ToString("dd/MM/yyyy")</strong> al <strong>@Model.To.ToString("dd/MM/yyyy")</strong>
</div>

<hr />

<div class="row">
    <div class="col-md-12">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3>Incarichi in Pancia (senza fatturato)</h3>
            <a href="@(Url.Action("ExportAssignmentsCsv", "Kpi", new { from = Model.From.ToString("yyyy-MM-dd"), to = Model.To.ToString("yyyy-MM-dd") }))" class="btn btn-success">
                <i class="fa fa-download"></i> Scarica Excel
            </a>
        </div>
        <p>Incarichi per consulente che non rientrano nel fatturato (senza stato fatturato)</p>
        <table class="table table-striped table-bordered">
            <thead class="thead-dark">
                <tr>
                    <th>Consulente</th>
                    <th>Totale Incarichi</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.ContributorAssignments != null && Model.ContributorAssignments.Any())
                {
                    @foreach (var item in Model.ContributorAssignments)
                    {
                        <tr>
                            <td>@item.ContributorName</td>
                            <td>@item.TotalAssignments</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="2" class="text-center">Nessun dato disponibile per il periodo selezionato</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<hr />

<div class="row">
    <div class="col-md-12">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3>Tempo Medio di Chiusura</h3>
            <a href="@(Url.Action("ExportClosingTimesCsv", "Kpi", new { from = Model.From.ToString("yyyy-MM-dd"), to = Model.To.ToString("yyyy-MM-dd") }))" class="btn btn-success">
                <i class="fa fa-download"></i> Scarica Excel
            </a>
        </div>
        <p>Tempo medio di chiusura (da data incarico a data chiusura) per consulente</p>
        <table class="table table-striped table-bordered">
            <thead class="thead-dark">
                <tr>
                    <th>Consulente</th>
                    <th>Pratiche Chiuse</th>
                    <th>Giorni Medi Chiusura</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.ContributorClosingTimes != null && Model.ContributorClosingTimes.Any())
                {
                    @foreach (var item in Model.ContributorClosingTimes)
                    {
                        <tr>
                            <td>@item.ContributorName</td>
                            <td>@item.ClosedCases</td>
                            <td>@item.AverageClosingDays.ToString("F2")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center">Nessun dato disponibile per il periodo selezionato</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<hr />

<div class="row">
    <div class="col-md-12">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3>Liquidato per Ramo</h3>
            <a href="@(Url.Action("ExportLiquidatedByBranchCsv", "Kpi", new { from = Model.From.ToString("yyyy-MM-dd"), to = Model.To.ToString("yyyy-MM-dd") }))" class="btn btn-success">
                <i class="fa fa-download"></i> Scarica Excel
            </a>
        </div>
        <p>Totale liquidato per consulente e ramo</p>
        <table class="table table-striped table-bordered">
            <thead class="thead-dark">
                <tr>
                    <th>Consulente</th>
                    <th>Ramo</th>
                    <th>Numero Pratiche</th>
                    <th>Totale Liquidato</th>
                    <th>Liquidato Medio</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.ContributorLiquidatedByBranch != null && Model.ContributorLiquidatedByBranch.Any())
                {
                    @foreach (var item in Model.ContributorLiquidatedByBranch)
                    {
                        <tr>
                            <td>@item.ContributorName</td>
                            <td>@item.BranchName</td>
                            <td>@item.TotalCases</td>
                            <td>@item.TotalLiquidated.ToString("C2")</td>
                            <td>@item.AverageLiquidated.ToString("C2")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center">Nessun dato disponibile per il periodo selezionato</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>