@model TableInsuranceAdjuster

<h3>@SharedLocalizer["Insurance Adjuster"]</h3>
<div class="row">
    <div class="col-md-12">
        <rystem-ajax-form rystem-modal-close="true" rystem-request-context="Manager.AjaxRequestManager.SetInsuranceAdjuster">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label class="control-label">@SharedLocalizer["Name"]</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="@SharedLocalizer["Save"]" class="btn btn-primary" />
            </div>
        </rystem-ajax-form>
    </div>
</div>